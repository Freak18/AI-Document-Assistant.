{
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/$1",
      "service": "backend"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "service": "frontend"
    }
  ]
}